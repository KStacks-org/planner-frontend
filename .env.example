# --- KPlanner environment ---
# Copy this file to `.env` and adjust as needed.
# All VITE_* vars are inlined into the client bundle at build time.

# Base URL of the KAUIndex API (used by the Planner's search + course sync).
VITE_BASE_URL=https://api.kauindex.com

# Base URL of the Schedly generator API (used by the Generate tab).
VITE_GEN_BASE_URL=https://api-schedly.y-tools.xyz

# Set to "yes" to short-circuit the app with an "under development" splash.
# Any other value renders the app normally.
VITE_IN_DEVELOPMENT=no
